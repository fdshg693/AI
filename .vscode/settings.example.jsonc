{
    // スキル
    // Gitub Copilot は自動で様々な箇所のスキルを読み込むため、必要最低限に絞ることでコンテキスト節約を図る
    // 以下では、 `.github/skills` のみを有効化している
    "chat.agentSkillsLocations": {
        ".agents/skills": false,
        ".claude/skills": false,
        "~/.agents/skills": false,
        "~/.copilot/skills": false,
        "~/.claude/skills": false,
        ".github/skills": true
    },
    // メモリ（インストラクション）
    // Github Copilot は AGETNS.md `rules/` フォルダ内のルールなどにある程度対応しているが、ネストされた場合の対応・異なる拡張子の場合音対応など、完全でないことが多い
    // 以下では、 `.github/instructions` のみを有効化している
    "chat.useNestedAgentsMdFiles": false,
    "chat.useClaudeMdFile": false,
    "chat.useAgentsMdFile": false,
    "chat.instructionsFilesLocations": {
        "~/.copilot/instructions": false,
        "~/.claude/rules": false,
        ".claude/rules": false,
        ".github/instructions": true
    },
    // エージェント
    // Github Copilot は 自動で様々な箇所のエージェントを読み込むため、必要最低限に絞ることでコンテキスト節約を図る
    // 以下では、 `.github/agents` のみを有効化している
    "chat.agentFilesLocations": {
        ".github/agents": true,
        "~/.copilot/agents": false,
        ".claude/agents": false
    }
}