# cp .env.example .env して値を埋める。.env はルートの .gitignore の *.env パターンに一致し、
# git管理対象外。poller.py起動前にexportするか、シェルの.envローダー等で読み込ませる
# （このリポジトリでは自動読み込みの仕組みは持たない。python-dotenv等は未使用）。
#
# ここに列挙する変数はホスト側で常駐する poller.py 自身が読む設定。コンテナに
# 注入される値の一部（ANTHROPIC_API_KEY等）も含むが、コンテナ側の環境変数一覧は
# ../docker/.env.example を参照。

# GitHub App認証（tools/sandbox/github_app/get_installation_token.py と共通）
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_INSTALLATION_ID=

# Claude Agent SDK認証（docker run時にコンテナへ注入される）
ANTHROPIC_API_KEY=

# 対象リポジトリ（省略時は fdshg693/AI に固定。00-overview.mdの暫定決定）
GITHUB_OWNER=
GITHUB_REPO=

# tools/sandbox/docker/ でビルドしたDockerイメージ名:タグ（必須）
SANDBOX_IMAGE=sandbox-agent:latest

# 以下はすべて省略可（既定値は poller.py の Config.from_env 参照）
SANDBOX_BASE_BRANCH=
SANDBOX_MODEL=
SANDBOX_MAX_TURNS=
SANDBOX_POLL_INTERVAL_SECONDS=
SANDBOX_MAX_ISSUES_PER_CYCLE=
SANDBOX_CONTAINER_MEMORY=
SANDBOX_CONTAINER_CPUS=
SANDBOX_CONTAINER_PIDS_LIMIT=
SANDBOX_CONTAINER_TIMEOUT_SECONDS=

# ISSUE試行記録（1 ISSUE = 1回までの制限）を保存するSQLiteファイルのパス。
# 相対パスの場合はorchestrator/ディレクトリからの相対パスとして解決される。
# 省略時は data/state.db（gitignore対象）
SANDBOX_STATE_DB_PATH=

# @sandboxメンションを実行してよいユーザーのauthor_association（カンマ区切り、大文字小文字区別なし）。
# ISSUE本文/コメントのうち実際に@sandboxと書いた投稿者がこの一覧に該当しない場合は無視される。
# 省略時は OWNER,COLLABORATOR 。指定可能な値: OWNER, COLLABORATOR, MEMBER, CONTRIBUTOR,
# FIRST_TIME_CONTRIBUTOR, FIRST_TIMER, NONE（GitHub APIの author_association 準拠）
SANDBOX_ALLOWED_AUTHOR_ASSOCIATIONS=
