{
  "private": true,
  "license": "MIT",
  "scripts": {
    "format": "prettier --write \"**/*.md\"",
    "format:check": "prettier --check \"**/*.md\"",
    "format:staged": "prettier --write",
    "skills-site:build": "pnpm --filter ai-skill-catalog-site run build",
    "skills-site:validate": "pnpm --filter ai-skill-catalog-site run validate",
    "skills-site:test": "pnpm --filter ai-skill-catalog-site run test",
    "skills-site:check": "pnpm run skills-site:build && pnpm run skills-site:validate && pnpm run skills-site:test",
    "skills-site:dev": "pnpm --filter ai-skill-catalog-site run dev"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "prettier": "^3.0.0",
    "secretlint": "^13.0.4"
  },
  "packageManager": "pnpm@11.15.0"
}
