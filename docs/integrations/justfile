set windows-shell := ["powershell.exe", "-NoLogo", "-NoProfile", "-Command"]

# Recipes run with this directory (docs/integrations) as cwd, so paths below are relative to it.

# GitHub URL of the tools/ submodule (fdshg693/AI-tools), used by the *-git recipes
# below (no local clone required). Package directories sit at its root.
repo_url := "https://github.com/fdshg693/AI-tools.git"

# List available recipes
default:
    @just --list

# Install aim CLI (tools/llm/aim) as an editable global tool via uv, from a local clone. See tools/llm/aim/README.md for API key setup.
aim-local:
    uv tool install --reinstall --editable ../../tools/llm/aim

# Install aim CLI directly from GitHub, no local clone required. Not editable: re-run this to pick up updates.
aim-git:
    uv tool install "git+{{repo_url}}#subdirectory=llm/aim"

# Install the tav-cli wrappers as the `tav` CLI, editable, via uv, from a local clone. See docs/integrations/cli-tools.md.
tavily-local:
    uv tool install --editable ../../tools/web-research/tav-cli

# Install the tav-cli wrappers directly from GitHub, no local clone required. Not editable: re-run this to pick up updates.
tavily-git:
    uv tool install "git+{{repo_url}}#subdirectory=web-research/tav-cli"

# Install skill-tools from a local clone as an editable global CLI.
skill-tools-local:
    uv tool install --editable --force ../../tools/skill-tools; if ($LASTEXITCODE -eq 0) { skill-tools config init } else { exit $LASTEXITCODE }

# Install or update skill-tools directly from GitHub main, without a local clone.
skill-tools-git:
    uv tool install --force "git+{{repo_url}}#subdirectory=skill-tools"; if ($LASTEXITCODE -eq 0) { skill-tools config init } else { exit $LASTEXITCODE }

# Install the textgraph CLI (tools/textgraph) as an editable global tool via uv, from a local clone. See tools/textgraph/README.md.
textgraph-local:
    uv tool install --editable ../../tools/textgraph

# Install the textgraph CLI directly from GitHub, no local clone required. Not editable: re-run this to pick up updates.
textgraph-git:
    uv tool install "git+{{repo_url}}#subdirectory=textgraph"

# Install the agents-rules CLI (tools/coding-agent/agents-rules) as an editable global tool via uv, from a local clone. See tools/coding-agent/agents-rules/README.md.
agents-rules-local:
    uv tool install --editable ../../tools/coding-agent/agents-rules

# Install the agents-rules CLI directly from GitHub, no local clone required. Not editable: re-run this to pick up updates.
agents-rules-git:
    uv tool install "git+{{repo_url}}#subdirectory=coding-agent/agents-rules"

# Install the cline-personal-info plugin (workflow/cline-wrapper, agent-compat/formats/cline/personal-info) globally for Cline SDK/CLI.
# Shells out to Git Bash to dodge a PowerShell/cmd "uv_spawn 'npm'" ENOENT bug — see docs/integrations/cline.md.
cline-personal-info:
    & "C:/Program Files/Git/bin/bash.exe" -c "cline plugin install ../../agent-compat/formats/cline/personal-info --force"
